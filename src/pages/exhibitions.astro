---
import Base from '../layouts/Base.astro';

const exhibitions = [
  { title: "Joan Palle: Asymmetric Futures", venue: "Piana Gallery | Kraków", year: "2026", slug: "asymmetric-futures", img: "/images/exhibitions/asymmetric-futures/1.jpg" },
  { title: "Feeding Window. Dawid Dzwonkowski", venue: "Podgląd A-Z, ING Polish Art Foundation | Warsaw", year: "2026", slug: "feeding-window", img: "/images/exhibitions/ex-1.jpg" },
  { title: "Jura Shust: Żywica*Solar Plexus", venue: "Zachęta National Gallery of Art | Warsaw", year: "2026", slug: "jura-shust", img: "/images/news/jura-shust.jpg" },
  { title: "Samuel Kłoda: Creak, Crash and Crow", venue: "UFO Gallery | Kraków", year: "2026", slug: "samuel-kloda", img: "/images/exhibitions/samuel-kloda/2.jpg" },
  { title: "Ask me anything. WetMeWild. Justyna Górowska", venue: "RARO On-Site Projects | Barcelona", year: "2026", slug: "ask-me-anything", img: "/images/exhibitions/ex-4.jpg" },
  { title: "Permitted Vulnerability. Gvantsa Jishkariani", venue: "Espai Souvenir | Barcelona", year: "2026", slug: "permitted-vulnerability", img: "/images/exhibitions/ex-5.jpg" },
  { title: "to undo, to crumble, to vanish. Laureta Hajrullahu", venue: "National Gallery of Kosovo QAFA | Pristina", year: "2026", slug: "text-laureta", img: "/images/exhibitions/ex-6.jpg" },
  { title: "Other Tomorrows / City of Women", venue: "Museum of Modern Art | Warsaw", year: "2025–2026", slug: "other-tomorrows", img: "/images/exhibitions/ex-7.jpg" },
  { title: "A View of One's Own by Paulina Stasik", venue: "BWA | Tarnów", year: "2025", slug: "paulina-stasik", img: "/images/exhibitions/ex-8.jpg" },
  { title: "Slime by Joanna Fluder", venue: "Zachęta National Gallery | Warsaw", year: "2025", slug: "slime-by-joanna-fluder", img: "/images/exhibitions/ex-9.jpg" },
  { title: "Soft Smiths. Contemporary Women's* Metalwork", venue: "Center of Polish Sculpture | Orońsko", year: "2025", slug: "soft-smiths", img: "/images/exhibitions/ex-10.jpg" },
  { title: "Hyperlocality. Personal Cartographies", venue: "CasCaDas ArtSpace | Barcelona", year: "2025", slug: "hyperlocality", img: "/images/exhibitions/ex-11.jpg" },
  { title: "Mammals&Suckers", venue: "HOS Gallery | Warsaw", year: "2025", slug: "mammalssuckers", img: "/images/exhibitions/ex-12.jpg" },
  { title: "Justyna Smoleń: Fragile Dreams", venue: "Bunkier Sztuki | Kraków", year: "2025", slug: "fragile-dreams", img: "/images/exhibitions/ex-13.jpg" },
  { title: "A Man Eating His Own Tail", venue: "CasCaDas ArtSpace | Barcelona", year: "2024", slug: "a-man-eating-his-own-tail", img: "/images/exhibitions/ex-14.jpg" },
  { title: "We Are a Dream", venue: "Kunsthalle.Ost | Leipzig", year: "2024", slug: "we-are-a-dream", img: "/images/exhibitions/ex-15.jpg" },
  { title: "From The Ashes", venue: "Zachęta National Gallery | Warsaw", year: "2024", slug: "from-the-ashes", img: "/images/exhibitions/ex-16.jpg" },
  { title: "Apparently Small Significance of Puddles", venue: "Art Walk Gallery", year: "2023", slug: "exhibition-1", img: "/images/exhibitions/ex-17.jpg" },
  { title: "Hit Me With Your Car", venue: "Galeria Promocyjna | Warsaw", year: "2023", slug: "hit-me-with-your-car", img: "/images/exhibitions/ex-18.jpg" },
  { title: "I Stand in Front of the Mirror Like Dog and Paint", venue: "HOS Gallery | Warsaw", year: "2023", slug: "maja-krysiak", img: "/images/exhibitions/ex-19.jpg" },
  { title: "Skin Deep", venue: "KRAKERS | Kraków", year: "2023", slug: "skin-deep", img: "/images/exhibitions/ex-20.jpg" },
  { title: "And Rivers Will Flow with Date Syrup", venue: "Galeria Promocyjna | Warsaw", year: "2023", slug: "ania-grzymala", img: "/images/exhibitions/ex-21.jpg" },
  { title: "Quench Thirst with Dew", venue: "UFO Art Gallery | Kraków", year: "2023", slug: "quench-thirst-with-dew", img: "/images/exhibitions/ex-22.jpg" },
  { title: "Cold Lips of the Waves", venue: "Gdańska Galeria Miejska | Gdańsk", year: "2022", slug: "cold-lips-of-waves", img: "/images/exhibitions/ex-23.jpg" },
  { title: "Room of Projected Horizons", venue: "Galeria Promocyjna | Warsaw", year: "2022", slug: "room-of-projected-horizons", img: "/images/exhibitions/ex-24.jpg" },
  { title: "In these days of tumult, heat and dazzle…", venue: "Stefan Gierowski's Foundation | Warsaw", year: "2021", slug: "in-these-days-of-tumult-heat-and-dazzle", img: "/images/exhibitions/ex-25.jpg" },
  { title: "Pure Crystal", venue: "Galeria Promocyjna | Warsaw", year: "2021", slug: "czysty-krysztal", img: "/images/exhibitions/ex-26.jpg" },
  { title: "Warsaw Preview", venue: "Jazdów | Warsaw", year: "2021", slug: "warsaw-preview", img: "/images/exhibitions/ex-27.jpg" },
  { title: "Year on the Protests", venue: "Krakow Photomonth | Kraków", year: "2021", slug: "year-on-protest", img: "/images/exhibitions/ex-28.jpg" },
  { title: "A Dream Within a Dream", venue: "Magic Garden | Warsaw", year: "2020", slug: "sen-we-snie", img: "/images/exhibitions/ex-29.jpg" },
  { title: "Beautiful Losers", venue: "Jak zapomnieć | Kraków", year: "2020", slug: "beautiful-loosers", img: "/images/exhibitions/ex-30.jpg" },
  { title: "Poland of Our Dreams", venue: "Warsaw", year: "2019", slug: "poland-of-our-dreams", img: "/images/exhibitions/ex-31.jpg" },
  { title: "Snake-Man", venue: "Jak zapomnieć | Kraków", year: "2019", slug: "snake-man", img: "/images/exhibitions/ex-32.jpg" },
  { title: "Apetite", venue: "Warsaw", year: "2018", slug: "apetite", img: "/images/exhibitions/ex-33.jpg" },
];

// Distinct years (newest first) for the year filter, like the News page.
// A "2025–2026" range contributes to BOTH years.
const years = [...new Set(exhibitions.flatMap((e) => e.year.match(/\d{4}/g) ?? []))].sort((a, b) => b.localeCompare(a));
const defaultYear = years[0];
---
<Base
  title="Exhibitions — Michalina Sablik, Curator of Contemporary Art"
  description="Exhibitions curated by Michalina Sablik — contemporary art shows, solo and group projects across galleries and institutions in Warsaw, Poland and abroad."
>
  <div class="container page-content">
    <div class="year-tabs" style="display: flex; gap: 1rem; margin-bottom: 0.5rem; margin-top: 2rem; flex-wrap: wrap;">
      {years.map((y) => (
        <button class={`year-tab${y === defaultYear ? " active" : ""}`} data-year={y}>{y}</button>
      ))}
    </div>
    <div class="exhibition-list" style="margin-top: 1.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
      {exhibitions.map((ex, i) => (
        <div class={`exhibition-entry${ex.year.includes(defaultYear) ? " visible" : ""}`} data-year={ex.year} style="margin-bottom: 0;">
          {ex.slug ? (
            <a href={`/exhibitions/${ex.slug}/`}>
              <img src={ex.img ?? `/images/exhibitions/ex-${i + 1}.jpg`} alt={ex.title} loading="lazy"
                style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:0.8rem;"
                onerror="this.src=this.src.replace('.jpg','.png');this.onerror=()=>{this.src=this.src.replace('.png','.jpeg');this.onerror=null}" />
            </a>
          ) : (
            <img src={ex.img ?? `/images/exhibitions/ex-${i + 1}.jpg`} alt={ex.title} loading="lazy"
              style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:0.8rem;"
              onerror="this.src=this.src.replace('.jpg','.png');this.onerror=()=>{this.src=this.src.replace('.png','.jpeg');this.onerror=null}" />
          )}
          <div class="exhibition-item">
            <div>
              {ex.slug ? (
                <a href={`/exhibitions/${ex.slug}/`} class="exhibition-title">{ex.title}</a>
              ) : (
                <span class="exhibition-title">{ex.title}</span>
              )}
            </div>
            <div class="exhibition-venue">{ex.venue} | {ex.year}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
  <style>
    .year-tabs {
      border-bottom: 1px solid #333;
      padding-bottom: 0;
    }
    .year-tab {
      background: none;
      border: none;
      color: #999;
      font-size: 1.1rem;
      padding: 0.5rem 1rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 0.2s, border-color 0.2s;
      font-family: inherit;
    }
    .year-tab:hover { color: #000; }
    .year-tab.active {
      color: #000;
      font-weight: 700;
      border-bottom-color: #000;
    }
    .exhibition-entry[data-year] { display: none; }
    .exhibition-entry.visible { display: block; }
    .exhibition-item {
      margin-top: 0.6rem;
    }
    .exhibition-title {
      font-weight: 600;
      font-size: 0.95rem;
      line-height: 1.3;
      display: block;
      margin-bottom: 0.25rem;
    }
    .exhibition-venue {
      font-size: 0.8rem;
      color: #888;
      line-height: 1.3;
    }
    @media (max-width: 900px) {
      .exhibition-list { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 600px) {
      .exhibition-list { grid-template-columns: 1fr !important; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const yearTabs = document.querySelectorAll('.year-tab');
      const entries = document.querySelectorAll('.exhibition-entry[data-year]');
      let activeYear = yearTabs.length ? yearTabs[0].getAttribute('data-year') : '';
      function filterEntries() {
        entries.forEach((el) => {
          const y = el.getAttribute('data-year') || '';
          if (activeYear && y.includes(activeYear)) el.classList.add('visible');
          else el.classList.remove('visible');
        });
      }
      yearTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          activeYear = tab.getAttribute('data-year');
          yearTabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          filterEntries();
        });
      });
      filterEntries();
    });
  </script>
</Base>
