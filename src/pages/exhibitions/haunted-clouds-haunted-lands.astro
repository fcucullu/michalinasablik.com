---
import Base from '../../layouts/Base.astro';

const photos = [1];
const alts: Record<number, string> = {
  1: 'Still from "Rite, Raid, Ride", screened at Haunted Clouds, Haunted Lands',
};
const artists = [
  'Mourae Lois Búa', 'Eliza Chojnacka', 'Dorota Gawęda & Eglė Kulbokaitė',
  'Eternal Engine (Martix Navrot, Jagoda Wójtowicz)', 'Jura Shust',
  'Weronika Wysocka', 'Oksana Pawełko',
];
---
<Base
  title="Haunted Clouds, Haunted Lands — Michalina Sablik"
  description="Haunted Clouds, Haunted Lands — a screening night of film and performance at Malpais, Barcelona, curated by Michalina Sablik as part of Loop City Screen 2026. 19 November 2026, 7 PM."
>
  <div class="container page-content">
    <div class="ex-layout">
      <div class="ex-text">
        <h1>Haunted Clouds, Haunted Lands</h1>
        <p class="exhibition-detail-venue">Malpais | Barcelona | 2026</p>
        <div class="exhibition-detail-body">
          <p>Haunted Clouds, Haunted Lands is an evening of film and performance, part of the Loop City Screen 2026 programme. It brings together five video works by artists and collectives rooted in Eastern Europe but working in international contexts, a musical performance by the Galician artist Mourae Lois Búa, and textile works by Eliza Chojnacka.</p>
          <p>The films show the world we live in as damaged, fractured and haunted. Their mood recalls folk horror: spectres and local demons appear alongside post-apocalyptic imagery taken from digital pop culture. The protagonists — ghosts, hybrids, speculative communities — move through landscapes of crisis marked by recent political upheaval. They exist inside digital realities built from glitch and artificial intelligence, on a horizon shaped by technological acceleration, surveillance and ecological violence.</p>
          <p>Yet these narratives also look for healing and release. They search for new forms of spirituality through ritual, community and encounters with nature. The works draw on magic both archaic and contemporary, retelling local myths and imagining other ways of being together. Here the moving image, and the stories it summons, become tools of political, somatic and technological speculation — a way of renegotiating what it means to exist in the world today.</p>
        </div>
        <div class="exhibition-detail-credits">
          <p><strong>Date:</strong> 19 November 2026, 7:00 PM</p>
          <p><strong>Curator:</strong> Michalina Sablik</p>
          <p><strong>Coordination:</strong> Joan Palle</p>
          <p><strong>Artists:</strong> {artists.join(', ')}</p>
          <p><strong>Venue:</strong> Malpais, Barcelona</p>
          <p><strong>Part of:</strong> <a href="https://loop-barcelona.com/city-screen/" target="_blank" rel="noopener">Loop City Screen 2026</a></p>
          <p><strong>Partners:</strong> Instituto Polaco de Cultura</p>
        </div>
      </div>
      <div class="ex-thumbs">
        {photos.map((n) => (
          <img src={`/images/exhibitions/haunted-clouds-haunted-lands/${n}.jpg`} alt={alts[n]} loading="lazy" class="thumb" data-index={n - 1} onclick="openLightbox(this.dataset.index)" />
        ))}
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" onclick="if(event.target===this)closeLightbox()">
    <button class="lb-close" onclick="closeLightbox()">&times;</button>
    <button class="lb-prev" onclick="navLightbox(-1)">&#8249;</button>
    <img id="lb-img" src="" alt='Still from "Rite, Raid, Ride", screened at Haunted Clouds, Haunted Lands' />
    <button class="lb-next" onclick="navLightbox(1)">&#8250;</button>
  </div>

  <style>
    .ex-layout { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; align-items: start; }
    .ex-thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .thumb { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 3px; cursor: pointer; transition: opacity 0.2s; }
    .thumb:hover { opacity: 0.8; }
    @media (max-width: 700px) { .ex-layout { grid-template-columns: 1fr; } .ex-thumbs { grid-template-columns: 1fr 1fr 1fr; } }
    #lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 9999; align-items: center; justify-content: center; }
    #lightbox.active { display: flex; }
    #lb-img { max-width: 90vw; max-height: 90vh; object-fit: contain; border-radius: 4px; }
    .lb-close { position: absolute; top: 1rem; right: 1.5rem; font-size: 2.5rem; color: #fff; background: none; border: none; cursor: pointer; z-index: 10; }
    .lb-prev, .lb-next { position: absolute; top: 50%; transform: translateY(-50%); font-size: 3rem; color: #fff; background: none; border: none; cursor: pointer; padding: 1rem; z-index: 10; }
    .lb-prev { left: 1rem; } .lb-next { right: 1rem; }
    .lb-prev:hover, .lb-next:hover { color: #ccc; }
  </style>

  <script is:inline define:vars={{ photoCount: photos.length, photoAlts: alts }}>
    const totalPhotos = photoCount;
    let currentIndex = 0;
    function showPhoto() { const img = document.getElementById('lb-img'); img.src = `/images/exhibitions/haunted-clouds-haunted-lands/${currentIndex + 1}.jpg`; img.alt = photoAlts[currentIndex + 1] || ''; }
    function openLightbox(index) { currentIndex = parseInt(index); showPhoto(); document.getElementById('lightbox').classList.add('active'); document.body.style.overflow = 'hidden'; }
    function closeLightbox() { document.getElementById('lightbox').classList.remove('active'); document.body.style.overflow = ''; }
    function navLightbox(dir) { currentIndex = (currentIndex + dir + totalPhotos) % totalPhotos; showPhoto(); }
    document.addEventListener('keydown', (e) => { if (!document.getElementById('lightbox').classList.contains('active')) return; if (e.key === 'Escape') closeLightbox(); if (e.key === 'ArrowLeft') navLightbox(-1); if (e.key === 'ArrowRight') navLightbox(1); });
    window.openLightbox = openLightbox; window.closeLightbox = closeLightbox; window.navLightbox = navLightbox;
  </script>
</Base>
