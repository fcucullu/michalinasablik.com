---
import Base from '../layouts/Base.astro';

const slides = [
  { image: "/images/exhibitions/jura-shust/promo.jpg", mobileImage: "/images/exhibitions/jura-shust/mobile.jpg", title: "Jura Shust: Żywica*Solar Plexus", subtitle: "Zachęta National Gallery of Art, Warsaw | Opening: July 16, 2026", link: "/exhibitions/jura-shust/", type: "exhibition", mobileFit: "contain" },
  { image: "/images/exhibitions/feeding-window/1.jpg", mobileImage: "/images/exhibitions/feeding-window/mobile.jpg", title: "Feeding Window. Dawid Dzwonkowski", subtitle: "ING Polish Art Foundation, Warsaw | Opening: June 23, 2026, 6:00 PM", link: "/exhibitions/feeding-window/", type: "exhibition" },
];

const podcasts = [
  { title: "Południe RDC: Michalina Sablik o wystawie „Żywica* Splot słoneczny” Jury Shusta w Zachęcie", image: "/images/podcasts/poludnie-rdc-michalina-sablik.jpg", link: "https://www.rdc.pl/podcast/poludnie-rdc_mWFYkAw8N302RRpMsYbz?episode=OzIcQyWhPvekKrhGQRhu" },
  { title: "Radio Nowy Świat „W środku dnia”: Michalina Sablik o wystawie „Żywica* Splot słoneczny” Jury Shusta w Zachęcie", image: "/images/podcasts/radio-nowy-swiat-w-srodku-dnia.jpg", link: "https://nowyswiat.online/podcasty/w-srodku-dnia-21072026" },
  { title: "TOK FM „Kultura osobista”: Zaproszenie na wystawę Joanny Fluder „Śluz…” w warszawskiej Zachęcie", image: "/images/podcasts/tokfm-kultura-osobista-sluz.jpg", link: "https://audycje.tokfm.pl/podcast/179056,Zaproszenie-na-wystawe-Joanny-Fluder-sluz-w-warszawskiej-Zachecie" },
  { title: "Dwójka „Sztuka mniej obca”: Ikona surrealizmu — Leonora Carrington", image: "/images/podcasts/dwojka-sztuka-mniej-obca-carrington.jpg", link: "https://www.polskieradio.pl/dwojka/audycje/sztuka-mniej-obca,11321/odcinek/ikona-surrealizmu-leonora-carrington,bc442a73-5db3-4118-85cc-2b4523f45715" },
  { title: "Godzina Szumu #108 Justyna Szylman, Michalina Sablik i Aleksandra Skowrońska o nowym otwarciu w Zachęcie", image: "/images/podcasts/godzina-szumu-108.jpg", link: "https://open.spotify.com/episode/3vGJBkrJZZlAHlRmG1f3qU" },
  { title: "Bęc Radio: Szukając nowych utopii → Sablik", image: "/images/podcasts/bec-radio-nowe-utopie.jpg", link: "https://open.spotify.com/episode/18YEUZFD0E5zEfG0b8LUtu" },
  { title: "Sztuka nieobojętności: Nowe otwarcie Zachęty", image: "/images/podcasts/sztuka-nieobojetnosci.jpg", link: "https://open.spotify.com/episode/2JbnJd5h13EXz3nx24zppz" },
];
---
<Base
  title="Michalina Sablik — Curator of Contemporary Art"
  description="Michalina Sablik is an art historian and independent curator of contemporary art (kuratorka sztuki współczesnej) based in Warsaw — curating exhibitions, public programs and critical texts, with mentoring for artists and consulting for institutions."
>
  <div class="slideshow">
    {slides.map((slide, i) => (
      <div class={`slide ${i === 0 ? 'active' : ''} ${slide.mobileFit === 'contain' ? 'mobile-contain' : ''}`} data-index={i}>
        {slide.mobileImage ? (
          <picture>
            <source media="(max-width: 700px)" srcset={slide.mobileImage} />
            <img src={slide.image} alt={slide.title} />
          </picture>
        ) : (
          <img src={slide.image} alt={slide.title} />
        )}
        <div class="slide-overlay">
          <span class="slide-type">{slide.type}</span>
          <h2 class="slide-title">
            {slide.link ? (
              <a href={slide.link} target={slide.link.startsWith('http') ? '_blank' : '_self'} rel="noopener">{slide.title}</a>
            ) : (
              slide.title
            )}
          </h2>
          <p class="slide-subtitle">{slide.subtitle}</p>
        </div>
      </div>
    ))}
    <button class="slide-prev" onclick="slideNav(-1)">&#8249;</button>
    <button class="slide-next" onclick="slideNav(1)">&#8250;</button>
    <div class="slide-dots">
      {slides.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-dot={i} onclick={`goSlide(${i})`} />
      ))}
    </div>
  </div>

  <!-- Video section -->
  <div class="container" style="margin-top: 4rem; margin-bottom: 4rem;">
    <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem;">Watch Recent Videos with Lectures & Talks</h2>
    <div class="video-grid">
      <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 4px;">
        <iframe src="https://www.youtube.com/embed/JKKecKtBJAU" title="Lecture" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
      </div>
      <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 4px;">
        <iframe src="https://www.youtube.com/embed/Qj8U8Z4Ec2o" title="Talk" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
      </div>
    </div>
  </div>

  <!-- Podcasts -->
  <div class="container" style="margin-top: 4rem; margin-bottom: 4rem;">
    <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem;">Listen to Recent Podcasts</h2>
    <div class="podcast-grid">
      {podcasts.map((podcast) => (
        <a class="podcast-card" href={podcast.link} target="_blank" rel="noopener">
          <div class="podcast-cover">
            <img src={podcast.image} alt={podcast.title} loading="lazy" />
          </div>
          <p class="podcast-title">{podcast.title}</p>
        </a>
      ))}
    </div>
  </div>

  <!-- Contact -->
  <div class="container contact-section">
    <div class="contact-inner">
      <h2 class="contact-heading">Let's Work Together</h2>
      <p class="contact-subheading">Get in touch for collaborations in curating exhibitions, public programs & texts. I also offer mentoring for artists and private galleries, as well as consulting for institutions in programming.</p>
      <form id="contact-form" class="contact-form">
        <div class="form-row">
          <input type="text" name="name" placeholder="Your Name" required />
          <input type="email" name="email" placeholder="Your Email" required />
        </div>
        <textarea name="message" placeholder="Your Message" rows="5" required></textarea>
        <button type="submit">Send Message</button>
        <p id="form-status" class="form-status"></p>
      </form>
    </div>
  </div>

  <style>
    .contact-section {
      margin-top: 4rem;
      margin-bottom: 4rem;
      border-top: 1px solid #eee;
      padding-top: 3rem;
    }
    .contact-inner {
      max-width: 640px;
      margin: 0 auto;
      text-align: center;
    }
    .contact-heading {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .contact-subheading {
      font-size: 1rem;
      font-weight: 300;
      color: var(--gray-light);
      margin-bottom: 2rem;
      line-height: 1.6;
    }
    .contact-form {
      text-align: left;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #ddd;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 300;
      background: #fafafa;
      transition: border-color 0.2s;
    }
    .contact-form input:focus,
    .contact-form textarea:focus {
      outline: none;
      border-color: var(--black);
    }
    .contact-form textarea {
      margin-bottom: 1rem;
      resize: vertical;
    }
    .contact-form button {
      display: block;
      width: 100%;
      padding: 0.8rem;
      background: var(--black);
      color: var(--white);
      border: none;
      font-family: var(--font);
      font-size: 1rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .contact-form button:hover { opacity: 0.8; }
    .contact-form button:disabled { opacity: 0.5; cursor: not-allowed; }
    .form-status {
      text-align: center;
      margin-top: 1rem;
      font-size: 0.9rem;
      font-weight: 300;
      min-height: 1.4em;
    }
    .form-status.success { color: #2d7a3a; }
    .form-status.error { color: #c0392b; }
    @media (max-width: 700px) {
      .form-row { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button');
      const status = document.getElementById('form-status');
      const data = Object.fromEntries(new FormData(form));

      btn.disabled = true;
      btn.textContent = 'Sending...';
      status.textContent = '';
      status.className = 'form-status';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          status.textContent = 'Thank you! Your message has been sent.';
          status.classList.add('success');
          form.reset();
        } else {
          throw new Error();
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('error');
      }
      btn.disabled = false;
      btn.textContent = 'Send Message';
    });
  </script>

  <style>
    .video-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 700px) {
      .video-grid { grid-template-columns: 1fr; }
    }
    .podcast-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
    .podcast-card {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .podcast-cover {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 4px;
      background: #f2f2f2;
    }
    .podcast-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .podcast-card:hover .podcast-cover img {
      transform: scale(1.03);
    }
    .podcast-title {
      margin: 0.75rem 0 0.25rem;
      font-size: 0.85rem;
      line-height: 1.4;
      font-weight: 600;
    }
    @media (max-width: 1000px) {
      .podcast-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 700px) {
      .podcast-grid { grid-template-columns: 1fr 1fr; }
    }
    .slideshow {
      position: relative;
      width: 100vw;
      height: calc(100vh - 70px);
      margin-left: calc(-50vw + 50%);
      overflow: hidden;
    }
    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.8s ease;
    }
    .slide.active { opacity: 1; }
    .slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @media (max-width: 700px) {
      .slide.mobile-contain img { object-fit: contain; background: #e8eae7; }
    }
    .slide-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 3rem 4rem;
      background: linear-gradient(transparent, rgba(0,0,0,0.7));
    }
    .slide-type {
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 2px;
      color: rgba(255,255,255,0.6);
      margin-bottom: 0.5rem;
      display: block;
    }
    .slide-title {
      font-size: 2rem;
      font-weight: 600;
      color: #fff;
      margin-bottom: 0.5rem;
    }
    .slide-title a {
      color: #fff;
      text-decoration: none;
    }
    .slide-title a:hover { text-decoration: underline; }
    .slide-subtitle {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.7);
      font-weight: 300;
    }
    .slide-prev, .slide-next {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      font-size: 3rem;
      color: rgba(255,255,255,0.7);
      background: none;
      border: none;
      cursor: pointer;
      padding: 1rem;
      z-index: 10;
    }
    .slide-prev { left: 1rem; }
    .slide-next { right: 1rem; }
    .slide-prev:hover, .slide-next:hover { color: #fff; }
    .slide-dots {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 0.5rem;
      z-index: 10;
    }
    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.5);
      background: transparent;
      cursor: pointer;
      transition: background 0.3s;
    }
    .dot.active { background: #fff; }
    @media (max-width: 700px) {
      .slideshow { height: 100svh; height: calc(100vh - 60px); }
      .slide-overlay { padding: 1.5rem 1.25rem 4rem; background: linear-gradient(transparent 0%, rgba(0,0,0,0.8) 50%); }
      .slide-type { font-size: 0.6rem; margin-bottom: 0.3rem; }
      .slide-title { font-size: 1.1rem; line-height: 1.3; margin-bottom: 0.3rem; }
      .slide-subtitle { font-size: 0.8rem; }
      .slide-prev, .slide-next { font-size: 2rem; padding: 0.5rem; }
      .slide-dots { bottom: 1rem; }
      .dot { width: 8px; height: 8px; }
    }
  </style>

  <script is:inline>
    const totalSlides = 2;
    let current = 0;
    let timer;

    function goSlide(n) {
      document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
      document.querySelectorAll('.dot').forEach(d => d.classList.remove('active'));
      current = n;
      document.querySelector(`.slide[data-index="${current}"]`).classList.add('active');
      document.querySelector(`.dot[data-dot="${current}"]`).classList.add('active');
      resetTimer();
    }

    function slideNav(dir) {
      goSlide((current + dir + totalSlides) % totalSlides);
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => slideNav(1), 5000);
    }

    window.goSlide = goSlide;
    window.slideNav = slideNav;
    resetTimer();
  </script>
</Base>
